# Copy to .env and set paths to your local dataset folders.
# Keep downloaded datasets outside version control.
ASVSPOOF19_LA_DIR=/absolute/path/to/ASVspoof2019_LA
ASVSPOOF21_LA_DIR=/absolute/path/to/ASVspoof2021_LA
IN_THE_WILD_DIR=/absolute/path/to/InTheWild
SCAM_DIALOGUE_DIR=/absolute/path/to/scam-dialogue

# Optional local cache for Hugging Face datasets and model files.
HF_HOME=/absolute/path/to/huggingface-cache
